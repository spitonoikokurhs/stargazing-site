// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// Neon serves a pooled connection (PgBouncer) for runtime and a direct connection for DDL.
// Runtime queries use `url` (pooled); migrations automatically use `directUrl`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// One row per event night.
// status: "active" | "cancelled" | "completed" (validated in application code, not an enum).
// A cancelled night is a row created in advance with status "cancelled",
// which the /live page reads naturally.
model Session {
  id                 String        @id @default(cuid())
  date               String // local Europe/Athens calendar date of the event night, format "YYYY-MM-DD" — avoids UTC/local off-by-one bugs around midnight; unambiguous and sortable
  hotelId            String // slug, e.g. "caravia-beach", "oku-kos" — plain String so private venues need no schema change
  status             String        @default("active")
  cancellationReason String? // e.g. "weather"
  startedAt          DateTime? // when the first frame arrived; null for cancelled nights created in advance
  endedAt            DateTime? // set after 5 min of no frames
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  observations       Observation[]
  stackRuns          StackRun[]

  @@unique([date, hotelId]) // business rule: one session per hotel per night; blocks duplicate rows from retries/admin actions. Also serves date-only lookups (date is the leading column).
  @@index([status, date]) // /live page's "is tonight cancelled?" check
  @@index([hotelId, date]) // hotel-history browsing
}

// One row per object viewed within a session.
// source: "pegasus" | "seestar" (plain String — keeps migrations simple if devices are added).
model Observation {
  id                    String    @id @default(cuid())
  sessionId             String
  session               Session   @relation(fields: [sessionId], references: [id])
  objectName            String // pretty display name, e.g. "M31 — Andromeda Galaxy"
  rawTargetName         String? // exact unprocessed target string as reported by the device; new-object detection compares raw strings
  objectType            String? // e.g. "Galaxy", "Nebula", "Planet" — drives the object-type badge
  source                String // "pegasus" | "seestar"
  startedAt             DateTime // first frame of this object
  endedAt               DateTime? // set when object changes or session ends
  metadata              Json? // device-reported target data (RA/Dec, magnitude, constellation, ...)
  // Wall-clock time of the most recent CONFIRMED stackRun 'new' verdict from
  // lib/detect-transition.ts's detectTransition (see app/api/ingest/route.ts).
  // Drives that function's settling window (a bouncy/resettling stacker
  // must not thrash the milestone toggle with repeated false resets from one
  // real restart) — read + rewritten by ingest on every frame belonging to
  // this Observation. Null until the first confirmed reset; a fresh
  // Observation row's own creation is itself an implicit reset, so this is
  // set at creation time too, not left null until a SECOND reset occurs.
  lastStackRunStartedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  frames                Frame[]
  stackRuns             StackRun[]

  @@index([sessionId, startedAt]) // serves both the FK lookup and time-ordered browsing
  @@index([source, startedAt])
}

// One row per DETECTED stack-run transition (lib/detect-transition.ts's
// detectTransition, stackRun === 'new') — a parallel, purely additive record
// alongside Observation.lastStackRunStartedAt, not a replacement for it.
// Exists because Observation itself does NOT reliably split per real target
// change in production: the rawTargetName-based split at ingest never fires
// (the relay doesn't send targetName), so today every real session has
// exactly ONE Observation row per source, always named "Unknown." StackRun
// records the SAME transition moment ingest already detects for the
// milestone toggle, but as its own row with a catalog match attached, giving
// the session-history strip (app/live/LiveView.tsx) real per-target-change
// data to render instead of nothing.
//
// Created at ingest in the exact two places lastStackRunStartedAt is set:
// (1) a fresh Observation's first frame, (2) a detectTransition 'new'
// verdict within an existing Observation. objectId/objectName/objectType/
// confidence are populated from lib/catalog.ts's matchCoordinates ONLY when
// the triggering frame's astrometryState is 'solved' and both coordinates
// are present — otherwise left null (a slew-time stack run with no
// confident identity yet). See the opportunistic-upgrade logic in
// app/api/ingest/route.ts: on every SUBSEQUENT frame belonging to the
// currently-open StackRun, a fresh matchCoordinates result is compared
// against the stored confidence and only applied if it's a strict
// improvement (none < low < medium < high) — this is what turns a
// null-identity run (created mid-slew, before astrometry resolved) into a
// correctly-named one a frame or two later, without ever downgrading an
// already-good match.
model StackRun {
  id            String    @id @default(cuid())
  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id])
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id])
  source        String // "pegasus" | "seestar"
  startedAt     DateTime // the moment stackRun 'new' fired (server `now`, same clock as lastStackRunStartedAt)
  endedAt       DateTime? // set when the next stack run starts, or the session ends; null = this is the currently-active run
  objectId      String? // catalog id (lib/catalog.ts CatalogObject.id), e.g. "M13" — the pill's display label
  objectName    String? // catalog display name, e.g. "Hercules Globular Cluster"
  objectType    String? // catalog type string, e.g. "Globular Cluster" — drives type-color tinting
  confidence    String? // matchCoordinates' real Confidence value: "high" | "medium" | "low" | "none" — stored as-is, not collapsed; the client decides its own display threshold
  firstFrameId  String? // the frame whose detectTransition verdict triggered this StackRun
  latestFrameId String? // updated on every subsequent frame belonging to this run — feeds blobUrl in the history endpoint
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sessionId, source, startedAt]) // the history endpoint's own query: this session, this source, chronological
  @@index([observationId])
}

// One row per StackRun object-identity DECISION at ingest — a durable,
// queryable record of every match/fallback/upgrade outcome, so season-wide
// catalog-radius tuning ("how often did we fall back, at which coordinates,
// across the whole season") can be answered from Postgres days or weeks
// later rather than from ephemeral Vercel function logs. Written from the
// same two points in app/api/ingest/route.ts that decide a StackRun's
// identity (creation-time match + opportunistic upgrade), best-effort and
// non-fatal (a failed insert here must never fail the ingest, same
// degrade-silently discipline as StackRun tracking itself).
//
// result values (application-validated strings, not an enum — matches the
// project's convention of keeping status/confidence as plain String):
//   "matched"  — first successful catalog match at StackRun creation
//   "fallback" — the frame SOLVED but landed in empty catalog space (the
//                "Deep-sky field" case) — the primary tuning signal
//   "upgraded" — an existing run's identity strictly improved on a later
//                frame (includes a previously-null run finally resolving)
//
// ra/dec are the frame's SOLVED astrometry coordinates at the decision
// moment (StackRun itself does not store coordinates, so they're captured
// here explicitly — the whole point for radius tuning). confidence is
// matchCoordinates' real Confidence ("high"|"medium"|"low"|"none") for a
// match, null on a fallback. Rows are kept indefinitely (tiny data — a few
// per night — and season-end review is the whole point).
model MatchDecision {
  id          String   @id @default(cuid())
  sessionId   String // the Session this decision belongs to (for ?date= grouping via Session.date)
  stackRunId  String // the StackRun whose identity was decided
  source      String // "pegasus" | "seestar" | special-event slug
  result      String // "matched" | "fallback" | "upgraded"
  ra          Float // solved right ascension (degrees) at the decision moment
  dec         Float // solved declination (degrees) at the decision moment
  objectId    String? // catalog id when matched/upgraded; null on fallback
  confidence  String? // "high" | "medium" | "low" | "none" when matched/upgraded; null on fallback
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt]) // the debug endpoint's own query: this night's decisions, chronological
  @@index([result, createdAt]) // season-wide "all fallbacks over time" scan
}

// One row per event night's FINAL viewer-stats snapshot, persisted from the
// (48h-TTL, otherwise-ephemeral) Redis viewer counters so the season's
// audience numbers survive past the Redis expiry. Written best-effort at the
// finish trigger (see app/api/finish/route.ts — the one deliberate exception
// to that route's Redis-only scope) and reconstructable for still-unexpired
// past nights by scripts/backfill-viewer-stats.mjs. /api/viewer-stats?date=
// reads this table for a past night, falling back to live Redis for tonight.
//
// eventKey is the SAME stable per-event key the Redis counters use (see
// viewerEventKey / viewerSpecialEventKey in lib/redis.ts) — "YYYY-MM-DD:
// <hotelId>" for a hotel night, "<slug>:<revealAt>" for a special event — so
// a snapshot maps unambiguously back to the exact counters it came from.
// Unique on eventKey so a re-finish (or a backfill re-run) upserts the same
// night's row rather than duplicating it.
model ViewerStatsNightly {
  id            String   @id @default(cuid())
  eventKey      String   @unique // stable per-event key (viewerEventKey/viewerSpecialEventKey), e.g. "2026-07-18:oku-kos"
  scope         String // "hotel" | "event"
  date          String? // Athens calendar date "YYYY-MM-DD" for a hotel night; null for a multi-day special event (whose window isn't one date)
  hotelId       String? // hotel slug for a hotel night; null for a special event
  eventSlug     String? // special-event slug for scope="event"; null for a hotel night
  unique        Int // SCARD of the unique-viewers set at snapshot time
  maxConcurrent Int // the ratcheted max-concurrent score at snapshot time
  source        String   @default("finish") // "finish" (live snapshot) | "backfill" (reconstructed from surviving Redis keys)
  capturedAt    DateTime @default(now()) // when this snapshot was taken (finish time, or backfill run time)

  @@index([date]) // ?date= lookups and season browsing
}

// One row per ingested image.
// source is denormalized from Observation for query convenience —
// we often query frames by source directly without joining.
model Frame {
  id             String      @id @default(cuid())
  observationId  String
  observation    Observation @relation(fields: [observationId], references: [id])
  source         String // "pegasus" | "seestar"
  blobUrl        String // Vercel Blob URL of the stored full-size image (display)
  blobPath       String // Vercel Blob pathname — needed for deletion/cleanup operations
  thumbnailUrl   String? // populated when thumbnail generation lands at ingest (display)
  thumbnailPath  String? // Vercel Blob pathname of the thumbnail — for deletion/cleanup; populated together with thumbnailUrl
  stackMilestone Int? // 0 | 120 | 300 (First/2min/5min — see MILESTONE_SECONDS in lib/detect-transition.ts) for stacking-progression milestones; null for regular frames. No CHECK constraint; validity is enforced in application code.
  capturedAt     DateTime // device timestamp if known, else relay fetch time
  ingestedAt     DateTime    @default(now()) // when our server received the frame (distinct from capturedAt)
  sizeBytes      Int?
  width          Int?
  height         Int?
  sha256         String // content hash for dedup — computed server-side by /api/ingest from received bytes, never trusted from the client
  metadata       Json? // device-reported frame data (exposure count, integration time, gain, ...)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([source, sha256]) // hard DB-level dedup, guaranteed now that sha256 is required
  @@index([observationId])
  @@index([source, capturedAt]) // the money index: /api/status "most recent frame per source" every 10s
}
